# Copia este archivo como .env.local para desarrollo local.
# Nunca pongas llaves reales en index.html, script.js ni en archivos versionados.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Seguridad HTTP opcional para funciones serverless
# Ejemplo: http://localhost:3000,https://refricaz.com
ALLOWED_ORIGINS=

# Webhook temporal para leads si quieres usar SheetDB, Zapier o Make antes de Firebase
LEADS_WEBHOOK_URL=
